{
  "name": "dsh-video-understand",
  "version": "0.5.0",
  "description": "低成本视频理解工具：B站链接/BV/本地视频 → 信息层 → 摘要+问答（token 压缩 99.95%+）。引擎自包含，无需外部依赖。",
  "type": "module",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-video-understand": "./bin/doctor.mjs"
  },
  "scripts": {
    "test:tools": "node dsh/index.js --self-test",
    "doctor": "node bin/doctor.mjs",
    "install-engine": "python3 -m pip install -r engine/requirements.txt",
    "install-engine-layer": "python3 -m pip install -r engine/requirements-layer.txt"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "dsh/",
    "engine/",
    "skills/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "video-understand",
    "avis",
    "video-understanding",
    "low-cost",
    "bilibili"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilps2/dsh-video-understand.git"
  },
  "homepage": "https://github.com/ilps2/dsh-video-understand",
  "bugs": {
    "url": "https://github.com/ilps2/dsh-video-understand/issues"
  },
  "engines": {
    "node": ">=18"
  }
}